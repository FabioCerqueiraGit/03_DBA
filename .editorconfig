# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown usa dois espaços no fim da linha para quebra explícita.
trim_trailing_whitespace = false
indent_size = 2

[*.sql]
indent_size = 4

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,xml,config,csproj,props,targets}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf
